    "cross-env": "^7.0.3",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "inversify": "^6.0.1",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.1",
    "prisma": "^4.12.0",
    "reflect-metadata": "^0.1.13",
    "sharp": "^0.32.0",
    "shortid": "^2.2.16",
    "stripe": "^12.1.1",
    "typescript": "^5.1.6",
    "winston": "^3.8.2"
  },
