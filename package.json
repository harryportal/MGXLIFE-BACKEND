  "scripts": {
    "build": "tsc",
    "migrate:prod": "prisma migrate deploy",
    "reset:prod": "prisma migrate reset --force",
    "start": "node ./dist/index.js",
    "dev": " dotenv -e .env.development nodemon src/index.ts",
    "migrate:dev": "dotenv -e .env.development prisma migrate dev",
    "reset": "dotenv -e .env.development prisma migrate reset",
    "test": "dotenv -e .env.test npx jest --watchAll",
    "migrate:test": "dotenv -e .env.test prisma migrate dev"
  },
  "dependencies": {
    "bcrypt": "^5.1.0",
